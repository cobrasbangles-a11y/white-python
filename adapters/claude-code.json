{
  "_comment": [
    "What `white-python install` writes into .claude/settings.json.",
    "Shown here so you can wire it by hand, adapt it for another agent, or",
    "see exactly what the installer is doing before you let it touch a file.",
    "Replace /path/to/white-python with wherever you cloned this."
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /path/to/white-python/bin/white-python.js hook start"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /path/to/white-python/bin/white-python.js hook stop --reason question"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /path/to/white-python/bin/white-python.js hook stop --reason done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /path/to/white-python/bin/white-python.js hook stop --reason session-end"
          }
        ]
      }
    ]
  }
}
